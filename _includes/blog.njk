<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="./styles/style.css">
</head>
<body class="fade-in">

  <header>
    <h1>{{ title }}</h1>
    <div class="meta">
      <span>{{ author }}</span> · <span>{{ date }}</span>
    </div>
  </header>

  <article>
    {{ content | safe }}
  </article>

</body>
</html>
