<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>index</title>
    <link rel="stylesheet" href="./styles/style.css">
</head>
<body class="fade-in">
  <header>
    <h1>{{ title }}</h1>
    <div class="meta">
      <span>{{ author }}</span> · <span>{{ date }}</span>
    </div>
  </header>

  <section>
    <h3>Journal</h3>
    <ul>
      {% for post in collections.journal %}
        <li><a href="{{ post.data.permalink }}">{{post.data.title}}</a></li>
      {% endfor %}
    </ul>

    <h3>Track</h3>
    <ul>
      {% for post in collections.track %}
        <li><a href="{{ post.data.permalink }}">{{post.data.title}}</a></li>
      {% endfor %}
    </ul>
  </section>
    <h3>In-class_tests</h3>
    <ul>
      {% for post in collections.in_class %}
        <li><a href="{{ post.data.permalink }}">{{post.data.title}}</a></li>
      {% endfor %}
    </ul>


    {{ content|safe }}
    
</body>

</html>